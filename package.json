{
    "name": "cssfun",
    "version": "0.3.0",
    "description": "Near-zero runtime CSS-in-JS library",
    "type": "module",
    "main": "./dist/esm/index.js",
    "module": "./dist/esm/index.js",
    "types": "types/index.d.ts",
    "jsdelivr": "dist/cssfun.umd.min.js",
    "unpkg": "dist/cssfun.umd.min.js",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "import": "./dist/esm/index.js",
            "default": "./dist/esm/index.js"
        },
        "./StyleSheet": {
            "types": "./types/StyleSheet.d.ts",
            "import": "./dist/esm/StyleSheet.js",
            "default": "./dist/esm/StyleSheet.js"
        },
        "./StyleSheet.js": {
            "types": "./types/StyleSheet.d.ts",
            "import": "./dist/esm/StyleSheet.js",
            "default": "./dist/esm/StyleSheet.js"
        },
        "./css": {
            "types": "./types/css.d.ts",
            "import": "./dist/esm/css.js",
            "default": "./dist/esm/css.js"
        },
        "./css.js": {
            "types": "./types/css.d.ts",
            "import": "./dist/esm/css.js",
            "default": "./dist/esm/css.js"
        },
        "./createTheme": {
            "types": "./types/createTheme.d.ts",
            "import": "./dist/esm/createTheme.js",
            "default": "./dist/esm/createTheme.js"
        },
        "./createTheme.js": {
            "types": "./types/createTheme.d.ts",
            "import": "./dist/esm/createTheme.js",
            "default": "./dist/esm/createTheme.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "skills",
        "src",
        "types"
    ],
    "tsd": {
        "compilerOptions": {
            "module": "nodenext"
        }
    },
    "directories": {
        "example": "example",
        "test": "test",
        "doc": "docs"
    },
    "scripts": {
        "prepare": "npm run clean && npm run test && npm run build",
        "test": "mocha --require jsdom-global/register --reporter nyan test/*.js",
        "test:types": "tsd",
        "posttest": "npm run lint && npm run test:types",
        "lint": "eslint src test",
        "build": "rollup -c",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "version": "node scripts/bump-cdn-links.js && node scripts/release-changelog.js",
        "docs:api": "jsdoc2md --global-index-format grouped --module-index-format none --helper jsdoc2md/helper.cjs --partial jsdoc2md/header.hbs --partial jsdoc2md/sig-link.hbs --partial jsdoc2md/sig-link-html.hbs --partial jsdoc2md/sig-link-parent.hbs --files src/*.js > docs/api.md"
    },
    "repository": "github:8tentaculos/cssfun",
    "homepage": "https://cssfun.js.org",
    "bugs": "https://github.com/8tentaculos/cssfun/issues",
    "author": "Alberto Masuelli <alberto.masuelli@gmail.com> (https://github.com/8tentaculos)",
    "license": "MIT",
    "keywords": [
        "css",
        "css-in-js",
        "styles",
        "stylesheet",
        "scoped css",
        "near-zero runtime",
        "theme",
        "dark mode",
        "css variables",
        "ssr",
        "framework-agnostic",
        "no build",
        "typescript",
        "jss"
    ],
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@rollup/plugin-replace": "6.0.3",
        "@rollup/plugin-terser": "1.0.2",
        "chai": "6.3.0",
        "eslint": "10.13.0",
        "glob": "13.0.6",
        "globals": "17.13.0",
        "jsdoc-to-markdown": "9.1.3",
        "jsdom": "30.1.3",
        "jsdom-global": "3.0.2",
        "mocha": "12.0.3",
        "rollup": "4.65.0",
        "tsd": "0.33.0"
    },
    "dependencies": {
        "csstype": "3.2.3"
    }
}
